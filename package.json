{
  "name": "@bottobot/td-mcp",
  "version": "3.0.0-tm.1",
  "description": "TouchDesigner MCP: upstream v3.0.0 documentation tools + Temerarii live-control runtime (bridge, guardrails, capability tests).",
  "main": "index.js",
  "type": "module",
  "bin": {
    "td-mcp": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "capability-check": "node scripts/run-td-mcp-capability-check.js",
    "capability-check:failfast": "node scripts/run-td-mcp-capability-check.js --fail-fast",
    "release-gate": "npm run capability-check",
    "session-boot": "node scripts/session-boot-check.js",
    "session-boot:full": "node scripts/session-boot-check.js --full",
    "td-boot": "npm run session-boot",
    "td-shape-gen": "node scripts/td-shape-generator.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "touchdesigner",
    "documentation",
    "derivative",
    "vscode",
    "codium",
    "operators",
    "workflow",
    "chop",
    "top",
    "sop",
    "dat",
    "mat",
    "comp",
    "pop"
  ],
  "author": "Robert Spring",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bottobot/touchdesigner-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/bottobot/touchdesigner-mcp-server/issues"
  },
  "homepage": "https://github.com/bottobot/touchdesigner-mcp-server#readme",
  "files": [
    "index.js",
    "tools/",
    "td-bridge/",
    "data/",
    "wiki/operator-data-manager.js",
    "wiki/operator-data-python-api.js",
    "wiki/models/",
    "wiki/utils/",
    "wiki/processor/",
    "wiki/data/",
    "README.md",
    "CHANGELOG.md",
    "SETUP-INSTRUCTIONS.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.1.2",
    "zod": "^3.25.0",
    "express": "^4.22.1",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {}
}
